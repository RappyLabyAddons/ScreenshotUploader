.window {
    left: 50%;
    top: 50%;
    width: 200;
    height: 140;
    alignment-x: center;
    alignment-y: center;
    background-color: rgba(20, 20, 20, 0.9);
    border: 1 dark_gray;

    .header {
        left: 50%;
        width: 100%;
        height: 20;
        padding: 0 2 0 2;
        background-color: rgba(10, 10, 10, 0.4);

        .title {
            alignment: center;
        }
    }

    Scroll {
        height: calc(100% - 20);
        width: 100%;

        .content {
            height: fit-content;
            width: 100%;
            margin: 7 10 5 10;
            space-between-entries: 10;
        }

        Scrollbar {
            left: 0;
            top: 0;
            width: 5;
            height: 100%;
        }
    }
}

Uploader {
    left: 50%;
    width: 100%;
    height: 20;

    .icon {
        width: 16;
        height: width;
        alignment: left;
        margin-right: 5;
    }

    .button {
        alignment: right;
    }
}